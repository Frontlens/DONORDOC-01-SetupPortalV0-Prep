{
  "liveServer.settings.port": 5508,
  "liveSassCompile.settings.formats": [
    {
      "format": "compressed",
      "extensionName": ".css",
      "savePath": "/css"
    }
  ],
  "liveSassCompile.settings.excludeList": [
    "**/node_modules/**",
    "**/scss/components/**",
    "**/scss/sections/**",
    "**/scss/variables.scss",
    "**/scss/fonts.scss",
    "**/scss/global.scss",
    "**/scss/utilities.scss",
    "**/scss/responsive.scss"
  ],
  "liveSassCompile.settings.generateMap": true
}
