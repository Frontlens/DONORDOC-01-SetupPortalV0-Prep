{
  "liveServer.settings.port": 5506,
  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      "savePath": "/css"
    }
  ],
  "liveSassCompile.settings.excludeList": [
    "**/node_modules/**",
    "**/scss/components/**",
    "**/scss/sections/**",
    "**/scss/variables.scss",
    "**/scss/global.scss",
    "**/scss/utilities.scss"
  ],
  "liveSassCompile.settings.generateMap": true
}
